    {
      "severity": "error",
      "message": "Bytespider is blocked by robots.txt — ByteDance cannot use your pages as AI answer sources",
      "detail": "Bytespider (mixed) is disallowed from the site root, so ByteDance cannot read or cite this site.",
      "fix": "Remove the Disallow covering Bytespider in robots.txt, or add an explicit \"Allow: /\" for it.",
      "evidence": "Disallow: / (matched by Bytespider)",
      "ruleId": "ai-crawler/search-bots-blocked"
    },
    {
      "severity": "info",
      "message": "Crawl-delay of 1s applies to GPTBot, OAI-SearchBot, ClaudeBot, anthropic-ai, PerplexityBot",
      "detail": "Affected AI bots: GPTBot, OAI-SearchBot, ClaudeBot, anthropic-ai, PerplexityBot.",
      "fix": "Remove the Crawl-delay or exempt AI search bots with their own groups if you want your content indexed promptly.",
      "evidence": "User-agent: gptbot, oai-searchbot, claudebot, anthropic-ai, perplexitybot\nCrawl-delay: 1",
      "ruleId": "ai-crawler/crawl-delay"
    },
    {
      "severity": "info",
      "message": "Stale token 'anthropic-ai' — Anthropic now uses 'ClaudeBot'",
      "detail": "'anthropic-ai' matched retired token anthropic-ai; this rule has no effect on current Anthropic crawlers.",
      "fix": "Replace 'User-agent: anthropic-ai' with 'User-agent: ClaudeBot' (or delete the stale block).",
      "evidence": "User-agent: anthropic-ai",
      "ruleId": "ai-crawler/stale-tokens"
    },
    {
      "severity": "warn",
      "message": "1 of 5 sampled llms.txt links are broken",
      "detail": "Links in llms.txt should point to pages that actually load — broken entries undermine the whole file.",
      "fix": "Update or remove the dead links in /llms.txt.",
      "evidence": "https://docs.github.com/api/article (HTTP 400)",
      "ruleId": "llms-txt/broken-links"
    },
    {
      "severity": "warn",
      "message": "1 llms.txt link(s) point to pages robots.txt disallows for AI bots",
      "detail": "The file recommends these pages to AI consumers while robots.txt tells their crawlers to stay away — the contradiction makes the curated list useless for exactly the audience it was written for.",
      "fix": "Allow the recommended paths for AI crawler tokens in robots.txt, or remove those links from llms.txt.",
      "evidence": "https://github.com/github/github-mcp-server — blocked for Bytespider",
      "ruleId": "llms-txt/links-blocked-by-robots"
    },
    {
      "severity": "info",
      "message": "No emerging AI manifest files found",
      "detail": "Checked /agents.json, /ai.txt, /.well-known/ai-plugin.json — all absent. These conventions are early and entirely optional.",
      "fix": "Prioritize /llms.txt; add agents.json or ai.txt only if they fit your AI distribution strategy.",
      "ruleId": "llms-txt/ai-manifest"
    },
    {
      "severity": "warn",
      "message": "No JSON-LD structured data on the page",
      "detail": "AI engines use schema.org markup to identify entities, dates, authors and page types. Without it they fall back to unreliable inference.",
      "fix": "Add JSON-LD blocks describing the page (Article, Organization, BreadcrumbList, FAQPage as appropriate).",
      "ruleId": "schema/no-jsonld"
    },
    {
      "severity": "info",
      "message": "No Organization schema found",
      "detail": "Without entity grounding, engines cannot connect this site to a known organization — weaker trust signals for citation.",
      "fix": "Add an Organization JSON-LD block (name, url, logo, sameAs links) at least on the homepage.",
      "ruleId": "schema/no-organization"
    },
    {
      "severity": "info",
      "message": "No BreadcrumbList schema found",
      "detail": "Breadcrumbs expose site structure to machines; without them a page floats without context.",
      "fix": "Add BreadcrumbList JSON-LD matching the visible breadcrumb trail.",
      "ruleId": "schema/no-breadcrumb"
    },
    {
      "severity": "info",
      "message": "No question-shaped headings (h2/h3 ending in \"?\")",
      "detail": "Question headings map directly onto user prompts and make sections self-contained citable answers.",
      "fix": "Rewrite a few section headings as the actual questions your audience asks.",
      "ruleId": "content/no-question-headings"
    },
    {
      "severity": "info",
      "message": "No author attribution found",
      "detail": "No meta[name=author], rel=author, JSON-LD author or author/byline markup — the content looks anonymous.",
      "fix": "Attribute the content: an author byline, meta[name=author] or a Person in JSON-LD author.",
      "ruleId": "content/no-author"
    },
    {
      "severity": "info",
      "message": "Few concrete data points found (2 numeric stats)",
      "detail": "Percentages, growth figures and quantities give AI engines precise, attributable claims to quote.",
      "fix": "Add verifiable numbers — percentages, counts, benchmarks — near the claims they support.",
      "ruleId": "content/no-data-points"
    },
    {
      "severity": "info",
      "message": "17 of 24 images have no alt text",
      "detail": "Alt text is the primary way AI systems understand what an image shows; missing alt makes visual content uncitable.",
      "fix": "Write descriptive alt text for meaningful images (purely decorative ones can keep alt=\"\").",
      "ruleId": "content/images-no-alt"
    },
    {
      "severity": "info",
      "message": "Lead paragraph after the H1 is thin (~18 words)",
      "detail": "A teaser or caption-length opener is hard to quote verbatim; engines prefer a self-contained answer they can lift whole.",
      "fix": "Expand the opening paragraph into a direct, self-contained answer (roughly 40–80 words) before diving into details.",
      "evidence": "Tools and trends evolve, but collaboration endures. With GitHub, developers, agents, and code come together on one platf",
      "ruleId": "content/answer-first"
    },
    {
      "severity": "warn",
      "message": "No sitemap discoverable",
      "detail": "No Sitemap directive in robots.txt and /sitemap.xml does not resolve.",
      "fix": "Publish an XML sitemap at /sitemap.xml and declare it in robots.txt (\"Sitemap: https://…/sitemap.xml\").",
      "evidence": "https://github.com/sitemap.xml → HTTP 406",
      "ruleId": "technical/sitemap-missing"
    }
