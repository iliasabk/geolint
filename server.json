{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.iliasabk/geolint",
  "description": "ESLint for AI search: audits AI-crawler access, llms.txt, schema and citability.",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/iliasabk/geolint",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@iliasabk/geolint",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
